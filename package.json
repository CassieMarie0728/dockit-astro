{
  "name": "dockit-astro",
  "version": "1.0.1",
  "description": "DocKit Astro is a simple, modern documentation theme built using Astro and Tailwind CSS",
  "author": "Themefisher",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/clean-build.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy:cf-workers": "npm run build:release && wrangler deploy",
    "preview:cf-workers": "npm run build && wrangler dev",
    "check:links": "python3 scripts/check_links.py",
    "test:links": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "validate": "npm run test:links && npm run test:site-url && npm run build && npm run check:links && npm run check:structure",
    "check:structure": "python3 scripts/check_structure.py",
    "test:site-url": "node --test scripts/test_site_url.mjs",
    "check:release": "node scripts/check_site_url.mjs",
    "build:release": "npm run check:release && npm run build"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/starlight": "0.41.1",
    "@pagefind/default-ui": "^1.5.2",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "7.0.3",
    "astro-font": "^1.1.0",
    "marked": "^18.0.5",
    "sharp": "^0.35.2",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "astro-vtbot": "^2.1.12",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "wrangler": "^4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.12.0"
  }
}
